# Auto detect text files and perform LF normalization on checkout/commit
* text=auto eol=lf

# Explicitly declare text files
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.env.example text eol=lf

# Windows shell files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
